<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test projects are not AOT-annotated: they run under the JIT only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Matches the App so it can reference it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>BlenderLauncher.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlenderLauncher.App\BlenderLauncher.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>