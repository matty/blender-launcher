<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:BlenderLauncher.App.Controls"
        xmlns:loc="using:BlenderLauncher.App.Localisation"
        xmlns:vm="using:BlenderLauncher.App.ViewModels"
        x:Class="BlenderLauncher.App.Views.Dialogs.LaunchPickerWindow"
        x:DataType="vm:LaunchPickerViewModel"
        Title="{loc:Tr ui.launch_picker.title}"
        Width="680" Height="540" MinWidth="520" MinHeight="400"
        CanMinimize="False" CanMaximize="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BlSurfaceDetailBrush}"
        Foreground="{StaticResource BlTextBodyBrush}"
        FontSize="12">
  <!--
    Launch picker, upstream's LaunchingWindow: status line, the search fields (version, branch, hash, date),
    the installed builds with the matches bold and first, the launch timer, "Save current search for .blend files made
    in X.Y", Cancel and Launch. State in ViewModels/LaunchPickerViewModel.
  -->
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource BlTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Theme" Value="{StaticResource BlTextBox}" />
      <Setter Property="FontFamily" Value="{StaticResource BlMonoFont}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource BlDangerBrush}" />
    </Style>
    <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource BlDangerBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Theme" Value="{StaticResource BlButton}" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource BlTextMutedBrush}" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Grid.row.match">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid.row.match TextBlock.cell">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid.row TextBlock.cell">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Grid.row.match TextBlock.cell">
      <Setter Property="FontStyle" Value="Normal" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="{StaticResource BlRowHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource BlAccentRowBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource BlAccentRowHoverBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border Name="TitleBarHost" DockPanel.Dock="Top" BorderBrush="{StaticResource BlLine0Brush}" BorderThickness="0,0,0,1">
      <controls:AppTitleBar Name="TitleBar" />
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource BlSurfaceSidebarBrush}" BorderBrush="{StaticResource BlLine1Brush}"
            BorderThickness="0,1,0,0" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto">
        <Button Name="SaveButton" HorizontalAlignment="Left" Height="30" Content="{Binding SaveQueryText}"
                IsVisible="{Binding ShowSaveQuery}" IsEnabled="{Binding CanSaveQuery}" AutomationProperties.AutomationId="SaveQuery" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Name="CancelButton" MinWidth="92" Height="30" Content="{loc:Tr act.cancel}" AutomationProperties.AutomationId="PickerCancel" />
          <Button Name="LaunchButton" MinWidth="92" Height="30" Theme="{StaticResource BlPrimaryButton}" Content="{loc:Tr act.launch}"
                  IsEnabled="{Binding CanLaunch}" AutomationProperties.AutomationId="PickerLaunch" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Margin="20,14,20,12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
      <!-- File and status line -->
      <StackPanel Spacing="3">
        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BlTextHeadingBrush}" Text="{Binding Heading}"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" />
        <TextBlock Name="StatusText" Foreground="{StaticResource BlTextSecondaryBrush}" Text="{Binding Status}"
                   AutomationProperties.AutomationId="PickerStatus" />
        <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource BlTextMutedBrush}" Text="{Binding ArgsText}"
                   IsVisible="{Binding HasArgs}" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- Search fields -->
      <Grid Grid.Row="1" Margin="0,14,0,0" ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
        <TextBlock Classes="label" Text="{loc:Tr launching.version}" />
        <TextBox Name="VersionBox" Grid.Column="1" Margin="0,0,16,8" Text="{Binding VersionText}" Classes.invalid="{Binding VersionInvalid}"
                 PlaceholderText="{loc:Tr launching.any_v_placeholder}" ToolTip.Tip="{loc:Tr launching.help}"
                 AutomationProperties.Name="{loc:Tr launching.version}" AutomationProperties.AutomationId="PickerVersion" />
        <TextBlock Grid.Column="2" Classes="label" Text="{loc:Tr launching.branch}" />
        <TextBox Grid.Column="3" Margin="0,0,0,8" Text="{Binding BranchText}" Classes.invalid="{Binding BranchInvalid}"
                 PlaceholderText="lts,stable,daily" AutomationProperties.Name="{loc:Tr launching.branch}" AutomationProperties.AutomationId="PickerBranch" />
        <TextBlock Grid.Row="1" Classes="label" Text="{loc:Tr launching.bhash}" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,16,0" Text="{Binding HashText}" Classes.invalid="{Binding HashInvalid}"
                 AutomationProperties.Name="{loc:Tr launching.bhash}" AutomationProperties.AutomationId="PickerHash" />
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="{loc:Tr launching.date}" />
        <ComboBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" ItemsSource="{Binding DateChoices}" SelectedIndex="{Binding DateIndex}"
                  AutomationProperties.Name="{loc:Tr launching.date}" AutomationProperties.AutomationId="PickerDate" />
      </Grid>

      <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap" Text="{Binding Message}"
                 Foreground="{StaticResource BlTextSecondaryBrush}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Classes.error="{Binding MessageIsError}" AutomationProperties.AutomationId="PickerMessage">
        <TextBlock.Styles>
          <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{StaticResource BlDangerBrush}" />
          </Style>
        </TextBlock.Styles>
      </TextBlock>

      <!-- Column heads -->
      <Grid Grid.Row="3" Margin="12,12,12,4" ColumnDefinitions="2*,1.3*,1*,1.3*">
        <TextBlock Classes="head" Text="{loc:Tr ui.launch_picker.column.build}" />
        <TextBlock Grid.Column="1" Classes="head" Text="{loc:Tr ui.launch_picker.column.version}" />
        <TextBlock Grid.Column="2" Classes="head" Text="{loc:Tr ui.launch_picker.column.branch}" />
        <TextBlock Grid.Column="3" Classes="head" Text="{loc:Tr ui.launch_picker.column.date}" />
      </Grid>

      <Border Grid.Row="4" Background="{StaticResource BlSurfaceInsetBrush}" BorderBrush="{StaticResource BlLine1Brush}" BorderThickness="1"
              CornerRadius="{StaticResource BlRadiusRow}">
        <ListBox Name="BuildList" Theme="{StaticResource BlListBox}" Padding="4" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 SelectionMode="Single" AutomationProperties.Name="{loc:Tr ui.launch_picker.column.build}" AutomationProperties.AutomationId="PickerBuilds">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LaunchPickerRow">
              <Grid Classes="row" Classes.match="{Binding IsMatch}" ColumnDefinitions="2*,1.3*,1*,1.3*" Background="Transparent"
                    ToolTip.Tip="{Binding Folder}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="cell" Text="{Binding Name}" />
                  <Border IsVisible="{Binding IsDefault}" Background="{StaticResource BlBadgeBrush}" CornerRadius="{StaticResource BlRadiusBadge}"
                          Padding="5,1" VerticalAlignment="Center">
                    <TextBlock FontSize="10" Foreground="{StaticResource BlBadgeTextBrush}" Text="{loc:Tr ui.launch_picker.default}" />
                  </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="cell mono" FontFamily="{StaticResource BlMonoFont}" FontSize="11.5" Text="{Binding Version}" />
                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Branch}" />
                <TextBlock Grid.Column="3" Classes="cell mono" FontFamily="{StaticResource BlMonoFont}" FontSize="11.5" Text="{Binding Date}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <TextBlock Grid.Row="5" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{DynamicResource BlAccentBrush}" Text="{Binding CountdownText}"
                 IsVisible="{Binding IsCountingDown}" AutomationProperties.AutomationId="PickerCountdown" />
    </Grid>
  </DockPanel>
</Window>
