<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="using:BlenderLauncher.App.ViewModels.Detail"
             xmlns:loc="using:BlenderLauncher.App.Localisation"
             x:Class="BlenderLauncher.App.Views.Detail.AvailableDetailView"
             x:DataType="dvm:AvailableDetailViewModel">
  <!--
    A download in the detail panel: header, then Download · size, the progress with
    cancel, or "Installed — show in library"; then the Build section (Python is hidden for downloads).
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://BlenderLauncher/Views/Detail/DetailStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <!-- ============================================================ header -->
      <Border Classes="dl-header">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="pill" Background="{Binding Row.ChannelBackground}">
                <TextBlock Text="{Binding Row.ChannelName}" Foreground="{Binding Row.ChannelForeground}" />
              </Border>
              <Border Classes="tag" Background="{Binding Row.ChannelBackground}" IsVisible="{Binding Row.IsNew}">
                <TextBlock Text="{loc:Tr ui.list.new_tag}" Foreground="{Binding Row.ChannelForeground}" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="display" Text="{Binding Row.Version}" VerticalAlignment="Bottom"
                         TextTrimming="CharacterEllipsis" MaxWidth="240" />
              <TextBlock FontSize="14" Foreground="{StaticResource BlTextLabelBrush}" Text="{Binding Row.Label}"
                         IsVisible="{Binding Row.HasLabel}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
            </StackPanel>
            <TextBlock FontSize="12" Foreground="#8d8d8d" TextWrapping="Wrap" Text="{Binding Row.Name}" />
          </StackPanel>

          <!-- Idle: Download · size -->
          <Button Theme="{StaticResource BlButton}" Classes="accent large" HorizontalAlignment="Stretch"
                  IsVisible="{Binding Row.IsIdle}" Command="{Binding DownloadCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="12" Height="12" Stretch="Uniform" Stroke="#ffffff" StrokeThickness="1.5"
                    StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                    Data="M6,1 L6,8 M3,5.5 L6,8.5 L9,5.5 M1.5,11 L10.5,11" />
              <TextBlock Text="{Binding DownloadText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Busy: progress and cancel -->
          <StackPanel Spacing="6" IsVisible="{Binding Row.IsBusy}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource BlMonoFont}" FontSize="11"
                         Foreground="{StaticResource BlTextSecondaryAltBrush}" Text="{Binding Row.PercentText}" />
              <TextBlock FontSize="11" Foreground="{StaticResource BlTextSecondaryAltBrush}"
                         TextTrimming="CharacterEllipsis" Text="{Binding ProgressText}" />
            </DockPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Theme="{StaticResource BlGhostButton}" Margin="6,-6,-4,-6"
                      Padding="4" VerticalAlignment="Center" Command="{Binding CancelCommand}"
                      IsEnabled="{Binding Row.CanCancel}" ToolTip.Tip="{loc:Tr act.cancel}"
                      AutomationProperties.Name="{loc:Tr act.cancel}">
                <Path Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round"
                      Stroke="{StaticResource BlTextSecondaryBrush}" Data="M1,1 L9,9 M9,1 L1,9" />
              </Button>
              <ProgressBar Theme="{StaticResource BlProgressBar}" Classes="large" VerticalAlignment="Center"
                           Value="{Binding Row.Progress}" IsIndeterminate="{Binding Row.IsIndeterminate}" />
            </DockPanel>
          </StackPanel>

          <!-- Installed: show in library -->
          <Button Theme="{StaticResource BlButton}" HorizontalAlignment="Stretch" Height="34" CornerRadius="6"
                  Foreground="#eeeeee" IsVisible="{Binding Row.IsInstalled}" Command="{Binding ShowInLibraryCommand}"
                  Content="{loc:Tr ui.detail.show_in_library}" />
        </StackPanel>
      </Border>

      <!-- ============================================================ Build -->
      <Border Classes="dl-section">
        <StackPanel>
          <ToggleButton Theme="{StaticResource BlSectionHeader}" Content="{loc:Tr ui.detail.section.build}"
                        IsChecked="{Binding Panel.IsBuildExpanded}" />
          <StackPanel IsVisible="{Binding Panel.IsBuildExpanded}">
            <Grid Classes="dl-fields" ColumnDefinitions="78,*" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Classes="dl-label" Text="{loc:Tr ui.detail.field.branch}" />
              <SelectableTextBlock Grid.Column="1" Classes="dl-value dl-mono" Text="{Binding Row.Branch}" />

              <TextBlock Grid.Row="1" Classes="dl-label" Text="{loc:Tr ui.detail.field.commit}" />
              <DockPanel Grid.Row="1" Grid.Column="1">
                <Button DockPanel.Dock="Right" Theme="{StaticResource BlGhostButton}" Padding="3"
                        Margin="4,-3,0,-3" VerticalAlignment="Center" IsVisible="{Binding HasHash}"
                        Command="{Binding CopyHashCommand}" ToolTip.Tip="{loc:Tr ui.menu.copy_hash}"
                        AutomationProperties.Name="{loc:Tr ui.menu.copy_hash}">
                  <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.2"
                        Stroke="{StaticResource BlTextSecondaryBrush}"
                        Data="M5,5 L13,5 L13,14 L5,14 Z M3,11 L2,11 L2,2 L10,2 L10,3" />
                </Button>
                <TextBlock Classes="dl-value dl-mono" Text="{Binding CommitText}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Row.Hash}" />
              </DockPanel>

              <TextBlock Grid.Row="2" Classes="dl-label" Text="{loc:Tr ui.detail.field.built}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="dl-value" Text="{Binding Row.BuiltText}" />

              <TextBlock Grid.Row="3" Classes="dl-label" Text="{loc:Tr ui.detail.field.size}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Classes="dl-value dl-mono" Text="{Binding Row.SizeText}" />
            </Grid>
            <Border Classes="dl-desc" IsVisible="{Binding Row.HasDescription}">
              <SelectableTextBlock Text="{Binding Row.Description}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
