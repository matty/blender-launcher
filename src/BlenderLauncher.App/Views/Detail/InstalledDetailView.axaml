<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="using:BlenderLauncher.App.ViewModels.Detail"
             xmlns:loc="using:BlenderLauncher.App.Localisation"
             x:Class="BlenderLauncher.App.Views.Detail.InstalledDetailView"
             x:DataType="dvm:InstalledDetailViewModel">
  <!--
    An installed build in the detail panel: header and Launch, then the Build,
    Installation and Options sections, More (the upstream actions the design has no place for) and "Remove build".
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://BlenderLauncher/Views/Detail/DetailStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <!-- ============================================================ header -->
      <Border Classes="dl-header">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="pill" Background="{Binding Row.ChannelBackground}">
                <TextBlock Text="{Binding Row.ChannelName}" Foreground="{Binding Row.ChannelForeground}" />
              </Border>
              <Border Classes="tag default" IsVisible="{Binding Row.IsDefault}">
                <TextBlock Text="{loc:Tr ui.list.default_tag}" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="display" Text="{Binding Row.Version}" VerticalAlignment="Bottom"
                         TextTrimming="CharacterEllipsis" MaxWidth="240" />
              <TextBlock FontSize="14" Foreground="{StaticResource BlTextLabelBrush}" Text="{Binding Row.Label}"
                         IsVisible="{Binding Row.HasLabel}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
            </StackPanel>
            <TextBlock FontSize="12" Foreground="#8d8d8d" TextWrapping="Wrap" Text="{Binding Row.Name}" />
          </StackPanel>

          <TextBlock IsVisible="{Binding HasProblem}" Text="{Binding ProblemText}" TextWrapping="Wrap"
                     FontSize="12" LineHeight="18" Foreground="{StaticResource BlTextSecondaryBrush}" />

          <StackPanel Spacing="8" IsVisible="{Binding CanLaunch}">
            <Button Name="LaunchButton" Theme="{StaticResource BlButton}" Classes="accent large"
                    HorizontalAlignment="Stretch" Command="{Binding LaunchCommand}"
                    ToolTip.Tip="{loc:Tr ui.menu.launch_hint}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Panel Classes="dl-spinner" IsVisible="{Binding Row.IsStarting}" VerticalAlignment="Center">
                  <Ellipse Stroke="#59ffffff" StrokeThickness="1.5" />
                  <Arc Stroke="#ffffff" StrokeThickness="1.5" StartAngle="-90" SweepAngle="100">
                    <Arc.RenderTransform>
                      <RotateTransform />
                    </Arc.RenderTransform>
                  </Arc>
                </Panel>
                <Path IsVisible="{Binding IsNotStarting}" Width="11" Height="11" Stretch="Uniform"
                      VerticalAlignment="Center" Data="M2,1 L9,5 L2,9 Z" Fill="#ffffff" />
                <TextBlock Text="{Binding LaunchText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Classes="dl-running" IsVisible="{Binding Row.IsRunning}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Theme="{StaticResource BlGhostButton}" FontSize="11"
                        Foreground="#b8b8b8" VerticalAlignment="Center" Padding="6,2"
                        Command="{Binding QuitAllCommand}" Content="{loc:Tr ui.detail.quit_all}" />
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <Ellipse Classes="running dl-pulse" />
                  <TextBlock FontSize="12" Foreground="{StaticResource BlRunningPanelTextBrush}"
                             Text="{Binding Row.InstancesRunningText}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ Build -->
      <Border Classes="dl-section" IsVisible="{Binding IsRecognised}">
        <StackPanel>
          <ToggleButton Theme="{StaticResource BlSectionHeader}" Content="{loc:Tr ui.detail.section.build}"
                        IsChecked="{Binding Panel.IsBuildExpanded}" />
          <StackPanel IsVisible="{Binding Panel.IsBuildExpanded}">
            <Grid Classes="dl-fields" ColumnDefinitions="78,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Classes="dl-label" Text="{loc:Tr ui.detail.field.branch}" />
              <SelectableTextBlock Grid.Column="1" Classes="dl-value dl-mono" Text="{Binding Row.Branch}" />

              <TextBlock Grid.Row="1" Classes="dl-label" Text="{loc:Tr ui.detail.field.commit}" />
              <DockPanel Grid.Row="1" Grid.Column="1">
                <Button DockPanel.Dock="Right" Theme="{StaticResource BlGhostButton}" Padding="3"
                        Margin="4,-3,0,-3" VerticalAlignment="Center" IsVisible="{Binding HasHash}"
                        Command="{Binding CopyHashCommand}" ToolTip.Tip="{loc:Tr ui.menu.copy_hash}"
                        AutomationProperties.Name="{loc:Tr ui.menu.copy_hash}">
                  <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.2"
                        Stroke="{StaticResource BlTextSecondaryBrush}"
                        Data="M5,5 L13,5 L13,14 L5,14 Z M3,11 L2,11 L2,2 L10,2 L10,3" />
                </Button>
                <TextBlock Classes="dl-value dl-mono" Text="{Binding CommitText}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Row.Hash}" />
              </DockPanel>

              <TextBlock Grid.Row="2" Classes="dl-label" Text="{loc:Tr ui.detail.field.built}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="dl-value" Text="{Binding Row.BuiltText}" />

              <TextBlock Grid.Row="3" Classes="dl-label" Text="{loc:Tr ui.detail.field.python}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Classes="dl-value dl-mono" Text="{Binding Row.PythonText}" />

              <TextBlock Grid.Row="4" Classes="dl-label" Text="{loc:Tr ui.detail.field.size}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Classes="dl-value dl-mono" Text="{Binding Row.SizeText}" />
            </Grid>
            <Border Classes="dl-desc" IsVisible="{Binding Row.HasDescription}">
              <SelectableTextBlock Text="{Binding Row.Description}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ Installation -->
      <Border Classes="dl-section">
        <StackPanel>
          <ToggleButton Theme="{StaticResource BlSectionHeader}" Content="{loc:Tr ui.detail.section.installation}"
                        IsChecked="{Binding Panel.IsInstallExpanded}" />
          <StackPanel IsVisible="{Binding Panel.IsInstallExpanded}" Margin="14,10,14,14" Spacing="10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Theme="{StaticResource BlButton}" Classes="icon" Margin="4,0,0,0"
                      Command="{Binding OpenFolderCommand}" ToolTip.Tip="{loc:Tr ui.detail.open_folder}"
                      AutomationProperties.Name="{loc:Tr ui.detail.open_folder}">
                <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.3"
                      Stroke="{StaticResource BlTextValueBrush}"
                      Data="M1.5,4 Q1.5,3 2.5,3 L6,3 L7.5,4.5 L13.5,4.5 Q14.5,4.5 14.5,5.5 L14.5,12 Q14.5,13 13.5,13 L2.5,13 Q1.5,13 1.5,12 Z" />
              </Button>
              <Border Classes="field" ToolTip.Tip="{Binding Row.Path}">
                <TextBlock FontFamily="{StaticResource BlMonoFont}" FontSize="11" Foreground="#bdbdbd"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Row.Path}" />
              </Border>
            </DockPanel>
            <Grid Classes="dl-fields" ColumnDefinitions="78,*" Margin="0" RowDefinitions="Auto,Auto">
              <TextBlock Classes="dl-label" Text="{loc:Tr ui.detail.field.installed}" />
              <TextBlock Grid.Column="1" Classes="dl-value" Text="{Binding Row.InstalledOnText}" />
              <TextBlock Grid.Row="1" Classes="dl-label" Text="{loc:Tr ui.detail.field.last_used}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="dl-value" Text="{Binding Row.LastUsedText}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ Options -->
      <Border Classes="dl-section" IsVisible="{Binding IsRecognised}">
        <StackPanel>
          <ToggleButton Theme="{StaticResource BlSectionHeader}" Content="{loc:Tr ui.detail.section.options}"
                        IsChecked="{Binding Panel.IsOptionsExpanded}" />
          <StackPanel IsVisible="{Binding Panel.IsOptionsExpanded}" Margin="14,10,14,14" Spacing="2">
            <CheckBox Theme="{StaticResource BlCheckBox}" IsChecked="{Binding IsDefault}">
              <StackPanel Spacing="1">
                <TextBlock Text="{loc:Tr ui.detail.option.use_as_default}" />
                <TextBlock FontSize="11" Foreground="{StaticResource BlTextGroupBrush}" TextWrapping="Wrap"
                           Text="{loc:Tr ui.detail.option.use_as_default_hint}" />
              </StackPanel>
            </CheckBox>
            <CheckBox Theme="{StaticResource BlCheckBox}" IsChecked="{Binding IsFavourite}">
              <StackPanel Spacing="1">
                <TextBlock Text="{loc:Tr ui.detail.option.favorite}" />
                <TextBlock FontSize="11" Foreground="{StaticResource BlTextGroupBrush}" TextWrapping="Wrap"
                           Text="{loc:Tr ui.detail.option.favorite_hint}" />
              </StackPanel>
            </CheckBox>
            <CheckBox Theme="{StaticResource BlCheckBox}" IsChecked="{Binding IsPortable}">
              <StackPanel Spacing="1">
                <TextBlock Text="{loc:Tr ui.detail.option.portable}" />
                <TextBlock FontSize="11" Foreground="{StaticResource BlTextGroupBrush}" TextWrapping="Wrap"
                           Text="{loc:Tr ui.detail.option.portable_hint}" />
              </StackPanel>
            </CheckBox>
            <CheckBox Theme="{StaticResource BlCheckBox}" IsChecked="{Binding ReplaceOnNewBuild}"
                      IsVisible="{Binding Row.CanReplaceOnNewBuild}">
              <StackPanel Spacing="1">
                <TextBlock Text="{loc:Tr ui.detail.option.replace_on_new_build}" />
                <TextBlock FontSize="11" Foreground="{StaticResource BlTextGroupBrush}" TextWrapping="Wrap"
                           Text="{loc:Tr ui.detail.option.replace_on_new_build_hint}" />
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ More -->
      <Border Classes="dl-section" IsVisible="{Binding HasMore}">
        <StackPanel>
          <ToggleButton Theme="{StaticResource BlSectionHeader}" Content="{loc:Tr ui.detail.section.more}"
                        IsChecked="{Binding Panel.IsMoreExpanded}" />
          <StackPanel IsVisible="{Binding Panel.IsMoreExpanded}" Margin="10,8,10,10" Spacing="0">
            <Button Theme="{StaticResource BlButton}" Classes="accent" HorizontalAlignment="Stretch" Margin="4,2,4,8"
                    IsVisible="{Binding HasUpdate}" Command="{Binding UpdateCommand}"
                    Content="{Binding UpdateText}"
                    ToolTip.Tip="{loc:Tr act.a.update_tooltip}" />
            <ItemsControl ItemsSource="{Binding More}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="dvm:BuildMenuEntry">
                  <Panel>
                    <TextBlock IsVisible="{Binding HasChildren}" Text="{Binding Header}" Margin="8,6,8,2"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BlTextGroupBrush}" />
                    <Button IsVisible="{Binding !HasChildren}" Theme="{StaticResource BlGhostButton}"
                            Classes="dl-more" Classes.nested="{Binding IsNested}"
                            Command="{Binding Command}" IsEnabled="{Binding IsEnabled}"
                            ToolTip.Tip="{Binding ToolTip}" ToolTip.ServiceEnabled="{Binding HasToolTip}"
                            Content="{Binding Header}" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ Remove -->
      <Border Padding="14,16">
        <Button Theme="{StaticResource BlDangerButton}" HorizontalAlignment="Stretch" Height="30"
                Command="{Binding RemoveCommand}" Content="{loc:Tr ui.detail.remove}"
                ToolTip.Tip="{loc:Tr ui.menu.remove_hint}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
