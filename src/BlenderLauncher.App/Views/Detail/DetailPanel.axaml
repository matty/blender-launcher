<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlenderLauncher.App.ViewModels"
             xmlns:dvm="using:BlenderLauncher.App.ViewModels.Detail"
             xmlns:detail="using:BlenderLauncher.App.Views.Detail"
             xmlns:loc="using:BlenderLauncher.App.Localisation"
             x:Class="BlenderLauncher.App.Views.Detail.DetailPanel"
             x:DataType="vm:DetailPanelViewModel">
  <!--
    The detail panel. The host Border in MainWindow supplies the 300 px width, the #242424
    background, the left edge line and visibility. The body is chosen by type: an installed build or a download.
  -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="dvm:InstalledDetailViewModel">
      <detail:InstalledDetailView />
    </DataTemplate>
    <DataTemplate DataType="dvm:AvailableDetailViewModel">
      <detail:AvailableDetailView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <TextBlock Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
               TextWrapping="Wrap" Foreground="{StaticResource BlTextMuted2Brush}"
               IsVisible="{Binding !HasSelection}"
               Text="{loc:Tr ui.detail.no_selection}" />
    <ContentControl Content="{Binding Current}" IsVisible="{Binding HasSelection}" />
  </Panel>
</UserControl>
