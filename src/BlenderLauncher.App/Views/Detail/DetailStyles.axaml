<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Styles shared by the detail panel's bodies (InstalledDetailView, AvailableDetailView), from the design's detail
    panel markup. Included by each body with StyleInclude.

      Border.dl-header      header block: padding 20/18/16, bottom line #1a1a1a
      Border.dl-section     one collapsible section: bottom line #1a1a1a
      Grid.dl-fields        label column 78 (right-aligned #868686) and values (#d0d0d0), row gap 8, column gap 10
      TextBlock.dl-label / dl-value / dl-mono
      Border.dl-desc        the description card (#1f1f1f, radius 5)
      Border.dl-running     the running strip (green wash)
      Button.dl-more        a More-section row (ghost, left aligned)
      Panel.dl-spinner      the 11 px "Starting" spinner
  -->
  <!-- Selectable values can still be selected with the mouse, but are not Tab stops and show no focus ring. -->
  <Style Selector="SelectableTextBlock">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <Style Selector="Border.dl-header">
    <Setter Property="Padding" Value="18,20,18,16" />
    <Setter Property="BorderBrush" Value="{DynamicResource BlLineDetailBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.dl-section">
    <Setter Property="BorderBrush" Value="{DynamicResource BlLineDetailBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Grid.dl-fields">
    <Setter Property="Margin" Value="14,10,14,14" />
    <Setter Property="RowSpacing" Value="8" />
    <Setter Property="ColumnSpacing" Value="10" />
  </Style>
  <Style Selector="TextBlock.dl-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource BlTextFieldLabelBrush}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector=":is(TextBlock).dl-value">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource BlTextValueBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector=":is(TextBlock).dl-mono">
    <Setter Property="FontFamily" Value="{DynamicResource BlMonoFont}" />
  </Style>

  <Style Selector="Border.dl-desc">
    <Setter Property="Margin" Value="14,0,14,14" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource BlSurfaceCardBrush}" />
  </Style>
  <Style Selector="Border.dl-desc > :is(TextBlock)">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="#b0b0b0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.dl-running">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource BlRunningPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BlRunningPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Ellipse.dl-pulse">
    <Style.Animations>
      <Animation Duration="0:0:2" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button.dl-more">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource BlTextSectionBrush}" />
  </Style>
  <Style Selector="Button.dl-more.nested">
    <Setter Property="Margin" Value="14,0,0,0" />
  </Style>

  <Style Selector="Panel.dl-spinner">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
  </Style>
  <!-- The Arc carries a RotateTransform in the view, which the animation turns. -->
  <Style Selector="Panel.dl-spinner > Arc">
    <Style.Animations>
      <Animation Duration="0:0:0.7" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
