<Project>
  <!-- Central package management. Versions are pinned. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="App">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Installer, updates and uninstall (Setup.exe, portable zip, delta updates); vpk in dotnet-tools.json must match. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup Label="Core">
    <PackageVersion Include="AngleSharp" Version="1.10.1" />
    <!-- Not 1.0.0, which was published by mistake and is deprecated. -->
    <PackageVersion Include="SharpCompress" Version="0.50.8" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Stay on 3.2.2: Avalonia.Headless.XUnit 12.1.6 fails discovery on 4.0.3 (spike S8). Runner: Microsoft.Testing.Platform (global.json). -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />
  </ItemGroup>
</Project>
